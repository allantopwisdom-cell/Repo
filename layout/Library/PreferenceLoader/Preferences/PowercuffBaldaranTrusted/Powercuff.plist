<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>entry</key>
	<dict>
		<key>cell</key>
		<string>PSLinkCell</string>
		<key>icon</key>
		<string>icon.png</string>
		<key>label</key>
		<string>PowerCuff Baldaran Trusted</string>
	</dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Simulates a thermal pressure level through the system thermal subsystem. Defaults to Off. It does not freeze apps or cap frame rate.</string>
			<key>label</key>
			<string>Thermal Simulation</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.minis.powercuff-baldaran-trusted.settingschanged</string>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>default</key>
			<integer>0</integer>
			<key>defaults</key>
			<string>com.minis.powercuff-baldaran-trusted</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>footerText</key>
			<string>Selects a simulated thermal profile. Changes apply immediately.</string>
			<key>key</key>
			<string>PowerMode</string>
			<key>label</key>
			<string>Profile</string>
			<key>validTitles</key>
			<array>
				<string>Off</string>
				<string>Nominal</string>
				<string>Light</string>
				<string>Moderate</string>
				<string>Heavy</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
				<integer>2</integer>
				<integer>3</integer>
				<integer>4</integer>
			</array>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.minis.powercuff-baldaran-trusted.settingschanged</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.minis.powercuff-baldaran-trusted</string>
			<key>key</key>
			<string>RequireLowPowerMode</string>
			<key>label</key>
			<string>Only in Low Power Mode</string>
		</dict>
	</array>
</dict>
</plist>
