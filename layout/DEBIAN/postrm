#!/bin/sh
# Preserve preferences; reload only after files have been removed.
case "${1:-}" in
    remove)
        if command -v launchctl >/dev/null 2>&1; then
            if launchctl kickstart -k system/com.apple.thermalmonitord; then
                echo 'Powercuff: launchctl accepted the thermal daemon restart request; successful reload is not confirmed.'
            else
                status=$?
                echo "Powercuff: launchctl kickstart failed (exit $status); attempting TERM fallback." >&2
                if command -v killall >/dev/null 2>&1; then
                    if killall -TERM thermalmonitord; then
                        echo 'Powercuff: TERM sent to thermalmonitord; daemon restart and reload are not confirmed.' >&2
                    else
                        status=$?
                        echo "Powercuff: TERM fallback failed (exit $status); daemon reload is not confirmed." >&2
                    fi
                else
                    echo 'Powercuff: killall unavailable; daemon reload is not confirmed.' >&2
                fi
            fi
        else
            echo 'Powercuff: launchctl unavailable; attempting TERM fallback.' >&2
            if command -v killall >/dev/null 2>&1; then
                if killall -TERM thermalmonitord; then
                    echo 'Powercuff: TERM sent to thermalmonitord; daemon restart and reload are not confirmed.' >&2
                else
                    status=$?
                    echo "Powercuff: TERM fallback failed (exit $status); daemon reload is not confirmed." >&2
                fi
            else
                echo 'Powercuff: killall unavailable; daemon reload is not confirmed.' >&2
            fi
        fi
        echo 'Powercuff removed: manually respring once to unload the SpringBoard publisher, then verify daemon reload.'
        ;;
esac
exit 0
