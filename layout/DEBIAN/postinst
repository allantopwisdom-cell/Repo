#!/bin/sh
# Do not write preferences as root: SpringBoard and Settings use the mobile domain.
case "${1:-}" in
    configure)
        if command -v launchctl >/dev/null 2>&1 &&
           launchctl kickstart -k system/com.apple.thermalmonitord >/dev/null 2>&1; then
            :
        elif command -v killall >/dev/null 2>&1; then
            killall -TERM thermalmonitord >/dev/null 2>&1 || true
        fi
        echo 'Powercuff: respring once to load the matching SpringBoard publisher.'
        ;;
esac
exit 0
