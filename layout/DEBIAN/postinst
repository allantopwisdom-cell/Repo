#!/bin/sh
DOMAIN=com.minis.powercuff-baldaran-trusted

if command -v defaults >/dev/null 2>&1; then
    if ! defaults read "$DOMAIN" PowerMode >/dev/null 2>&1; then
        defaults write "$DOMAIN" PowerMode -int 0 2>/dev/null || true
    fi
    if ! defaults read "$DOMAIN" RequireLowPowerMode >/dev/null 2>&1; then
        defaults write "$DOMAIN" RequireLowPowerMode -bool NO 2>/dev/null || true
    fi
fi

if command -v launchctl >/dev/null 2>&1; then
    launchctl kickstart -k system/com.apple.thermalmonitord >/dev/null 2>&1 || true
fi
command -v killall >/dev/null 2>&1 && killall -9 thermalmonitord >/dev/null 2>&1 || true
exit 0
